# Spotify — https://developer.spotify.com/dashboard
# Register http://localhost:5173 as a Redirect URI in your Spotify app settings
# Required scopes: playlist-modify-public playlist-modify-private
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id_here
VITE_REDIRECT_URI=http://localhost:5173

# setlist.fm — https://www.setlist.fm/settings/api
VITE_SETLIST_FM_API_KEY=your_setlist_fm_api_key_here
